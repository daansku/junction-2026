# Copy to .env (cp .env.example .env). Never commit .env. Which key is which: docs/KEYS.md
# Claude (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
# Google Gemini (OpenAI-compatible layer)
GEMINI_API_KEY=
# NVIDIA build.nvidia.com API only. NOT the Nemotron key: Nemotron runs on Verda, use NVIDIA_VERDA_INFERENCE_KEY
NVIDIA_API_KEY=
# featherless.ai
FEATHERLESS_API_KEY=
# Verda (DataCrunch) inference keys. Each key works only for its own deployment.
# Nemotron 3.5 Super VL (model nemotron-3-5-super-vl; base URL fixed in arena/models.yaml):
NVIDIA_VERDA_INFERENCE_KEY=
# Verda managed inference (Kimi K3.1 Pro, model verda-kimi-k3-1-pro; URL fixed in arena/models.yaml):
VERDA_INFERENCE_KEY=
# Only for our own Verda deployment (verda-small), must end in /v1, e.g. https://<deployment>/v1
VERDA_BASE_URL=
# Modal endpoint (ends in /v1) + proxy auth token written as wk-<id>.ws-<secret>
MODAL_BASE_URL=
MODAL_API_KEY=
# Modal CLI token (deploy / fine-tune), not the endpoint key
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional plain OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Server
ADMIN_TOKEN=
ARENA_LOCAL_API=http://localhost:8000

# A3-11 fine-tuned model endpoint key (vLLM --api-key on our Verda GPU); URL goes in VERDA_BASE_URL
VERDA_FT_KEY=
