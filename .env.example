# Copy to .env and fill what you have. Only needed for --llm runs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# Self-hosted model (e.g. vLLM on a Verda GPU box): python -m vllm.entrypoints.openai.api_server ...
VLLM_BASE_URL=http://localhost:8000/v1
# Claude effort for the anthropic backend: low | medium | high | xhigh | max
SWITCHBOARD_EFFORT=high
