# Copy to .env on A3's machine only. Never commit .env.
# Claude (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
# Google Gemini (OpenAI-compatible layer)
GEMINI_API_KEY=
# NVIDIA build.nvidia.com API only. NOT the Nemotron key: Nemotron runs on Verda, use NVIDIA_VERDA_INFERENCE_KEY
NVIDIA_API_KEY=
# featherless.ai
FEATHERLESS_API_KEY=
# Verda (DataCrunch) inference keys. Each key works only for its own deployment.
# Nemotron 3.5 Super VL (model nemotron-3-5-super-vl; base URL fixed in arena/models.yaml):
NVIDIA_VERDA_INFERENCE_KEY=
# Our other Verda deployment (verda-small), e.g. VERDA_BASE_URL=https://<deployment>/v1
VERDA_BASE_URL=
VERDA_INFERENCE_KEY=
# Modal: our fine-tuned model served with vLLM, e.g. https://<app>.modal.run/v1
MODAL_BASE_URL=
MODAL_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional plain OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Server
ADMIN_TOKEN=
ARENA_LOCAL_API=http://localhost:8000
